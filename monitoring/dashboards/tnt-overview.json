{
  "annotations": { "list": [] },
  "title": "T&T Engine — System Overview",
  "uid": "tnt-overview",
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "current": { "value": "tnt-engine" }
      }
    ]
  },
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(tnt_http_requests_total{namespace=\"$namespace\"}[1m]))", "legendFormat": "total req/s" },
        { "expr": "sum(rate(tnt_http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[1m]))", "legendFormat": "5xx/s" }
      ]
    },
    {
      "title": "Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(tnt_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(tnt_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(tnt_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Error Rate",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 0.05, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.005 }, { "color": "red", "value": 0.01 }] } } },
      "targets": [
        { "expr": "sum(rate(tnt_http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[5m])) / sum(rate(tnt_http_requests_total{namespace=\"$namespace\"}[5m]))" }
      ]
    },
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.8 }] } } },
      "targets": [
        { "expr": "sum(rate(tnt_l1_cache_hits_total{namespace=\"$namespace\"}[5m])) / (sum(rate(tnt_l1_cache_hits_total{namespace=\"$namespace\"}[5m])) + sum(rate(tnt_l1_cache_misses_total{namespace=\"$namespace\"}[5m])))" }
      ]
    },
    {
      "title": "Tokenize Latency",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(tnt_tokenize_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, sum(rate(tnt_tokenize_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Detokenize Latency",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(tnt_detokenize_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, sum(rate(tnt_detokenize_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Tokens Created (1h)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 7 },
      "targets": [
        { "expr": "sum(increase(tnt_tokens_created_total{namespace=\"$namespace\"}[1h]))" }
      ]
    },
    {
      "title": "Circuit Breaker",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 7 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [
        { "expr": "sum(increase(tnt_crypto_errors_total{namespace=\"$namespace\"}[2m]))", "legendFormat": "crypto errors (2m)" }
      ]
    }
  ]
}
